# Postgres. Cualquier proveedor: lo único que se usa es SQL estándar.
# Usa la cadena agrupada (pooled), no la directa.
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos?sslmode=require

PUBLIC_SITE_URL=https://hornosanlorenzo-demo.vercel.app

# Better Auth. Genera uno nuevo con: openssl rand -base64 32
# Nunca se comparte entre entornos ni se comitea el valor real.
BETTER_AUTH_SECRET=

# Stripe — panel > Desarrolladores > Claves de API
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe — panel > Desarrolladores > Webhooks > firma del endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend — aviso de pedido pagado. Sin esto el pedido sigue en el panel de
# Stripe, pero no llega ningún correo.
RESEND_API_KEY=re_xxx
ORDER_NOTIFICATION_EMAIL=pedidos@hornosanlorenzo.com
ORDER_FROM_EMAIL=web@hornosanlorenzo.com

---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import { tradicion } from "~/data/tradicion";
---
<MarketingLayout
  title="Tradición y Calidad"
  description="Desde 1986: mantequilla de verdad, hojaldres laminados a mano, recetas de siempre. La calidad no viene de un sobre."
>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-12 sm:py-16">
    <p class="text-[11px] uppercase tracking-[0.25em] text-[color:var(--color-ink-muted)] font-semibold">Tradición y calidad</p>
    <h1 class="text-4xl sm:text-5xl mt-2">Desde 1986, sin atajos.</h1>
    <p class="text-xl text-[color:var(--color-ink-muted)] mt-6 leading-relaxed">{tradicion.intro}</p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      {tradicion.pillars.map((p) => (
        <article>
          <h2 class="text-2xl">{p.title}</h2>
          <p class="text-[color:var(--color-ink-muted)] mt-2 leading-relaxed">{p.body}</p>
        </article>
      ))}
    </div>

    <div class="mt-16 bg-[color:var(--color-cream)] rounded-[var(--radius-card)] p-8">
      <p class="text-[11px] uppercase tracking-[0.25em] text-[color:var(--color-ink-muted)] font-semibold">Certificaciones</p>
      <ul class="mt-3 space-y-2 text-sm">
        {tradicion.certifications.map((c) => <li>· {c}</li>)}
      </ul>
    </div>
  </section>
</MarketingLayout>

---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import ContactForm from "~/islands/ContactForm.tsx";
import { stores } from "~/data/stores";
import { site } from "~/data/site";
---
<MarketingLayout
  title="Contacto"
  description="Escríbenos o llama. Te respondemos en menos de 24 horas."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-12 grid gap-12 md:grid-cols-2">
    <div>
      <p class="text-[11px] uppercase tracking-[0.25em] text-[color:var(--color-ink-muted)] font-semibold">Contacto</p>
      <h1 class="text-4xl sm:text-5xl mt-2">Hablamos.</h1>
      <p class="text-[color:var(--color-ink-muted)] mt-3 max-w-md">Para pedidos pequeños usa WhatsApp en cada tienda. Para catering, eventos o consultas largas, este formulario.</p>

      <ul class="mt-8 space-y-5 text-sm">
        {stores.map((s) => (
          <li>
            <p class="font-[family-name:var(--font-display)] text-xl">{s.shortName}</p>
            <p class="text-[color:var(--color-ink-muted)]">{s.address}, {s.postal} {s.city}</p>
            <p><a href={`tel:${s.phone}`}>{s.phoneDisplay}</a> · <a href={`mailto:${s.email}`}>{s.email}</a></p>
          </li>
        ))}
        <li>
          <p class="text-[10px] uppercase tracking-[0.25em] text-[color:var(--color-ink-muted)] font-semibold">Redes</p>
          <p class="mt-1"><a href={site.social.instagram} rel="noopener" target="_blank">Instagram</a> · <a href={site.social.facebook} rel="noopener" target="_blank">Facebook</a></p>
        </li>
      </ul>
    </div>

    <div>
      <ContactForm client:visible />
    </div>
  </section>
</MarketingLayout>

---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import NewsCard from "~/components/NewsCard.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("noticias", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<MarketingLayout
  title="Noticias y promociones"
  description="Roscón de Reyes, San Valentín, Día del Padre, fiestas patronales y más."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
    <p class="text-[11px] uppercase tracking-[0.25em] text-[color:var(--color-ink-muted)] font-semibold">Noticias</p>
    <h1 class="text-4xl sm:text-5xl mt-2">Lo que tenemos esta temporada.</h1>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((n) => (
        <NewsCard
          slug={n.id}
          title={n.data.title}
          excerpt={n.data.excerpt}
          date={n.data.date}
          image={n.data.image}
          imageAlt={n.data.imageAlt}
        />
      ))}
    </div>
  </section>
</MarketingLayout>

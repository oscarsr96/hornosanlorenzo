---
import { Image } from "astro:assets";
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import { formatDate } from "~/lib/format";
import { site } from "~/data/site";
import { obtenerNoticia } from "~/lib/db/noticias";
import { aHtml } from "~/lib/markdown";

// Lee de la base de datos: bajo demanda, con la caché ISR delante
// (`astro.config.mjs`) y el panel invalidándola al publicar.
export const prerender = false;

const { slug } = Astro.params;
// `soloPublicada`: un borrador no se ve escribiendo su URL a mano.
let item: Awaited<ReturnType<typeof obtenerNoticia>> = null;
try {
  item = slug ? await obtenerNoticia(slug, { soloPublicada: true }) : null;
} catch (error) {
  // Un fallo de Postgres aquí no puede convertirse en un 500: se trata como
  // si la noticia no existiera, igual que un slug inventado.
  console.error(
    "No se pudo cargar la noticia:",
    error instanceof Error ? error.message : error,
  );
}
if (!item) return new Response("No encontrado", { status: 404 });

const cuerpo = await aHtml(item.cuerpo);
const fecha = new Date(`${item.fecha}T00:00:00`);
const imagen =
  item.imageUrl && item.imageWidth && item.imageHeight
    ? { url: item.imageUrl, alt: item.imageAlt ?? "", ancho: item.imageWidth, alto: item.imageHeight }
    : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: item.titulo,
  datePublished: fecha.toISOString(),
  // La URL del almacén ya es absoluta: a diferencia del Markdown de antes, no
  // hay que envolverla con `new URL(..., Astro.site)`.
  image: item.imageUrl ?? undefined,
  publisher: {
    "@type": "Organization",
    name: site.name,
    logo: { "@type": "ImageObject", url: new URL("/favicon.svg", Astro.site).toString() },
  },
};
---
<MarketingLayout
  title={item.titulo}
  description={item.excerpt}
  type="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-12">
    <nav aria-label="Breadcrumb" class="text-xs text-[color:var(--color-ink-muted)] uppercase tracking-widest mb-4">
      <a href="/">Inicio</a> · <a href="/noticias">Noticias</a> · <span>{item.titulo}</span>
    </nav>

    <p class="numeracion">{formatDate(fecha)}</p>
    <h1 class="text-4xl sm:text-5xl mt-2">{item.titulo}</h1>
    <p class="text-lg text-[color:var(--color-ink-muted)] mt-4">{item.excerpt}</p>

    <div class="mt-8 rounded-[var(--radius-card)] overflow-hidden border border-[color:var(--color-line)]">
      {imagen ? (
        <Image
          src={imagen.url}
          alt={imagen.alt}
          width={imagen.ancho}
          height={imagen.alto}
          widths={[600, 900, 1200]}
          sizes="(min-width:768px) 720px, 100vw"
          class="w-full h-auto"
        />
      ) : (
        <div class="w-full aspect-[16/10] flex items-center justify-center bg-[color:var(--color-latte)]" aria-hidden="true">
          <span class="numeracion">Foto pendiente</span>
        </div>
      )}
    </div>

    <div class="prose prose-stone mt-8 max-w-none [&_p]:my-4 text-[color:var(--color-ink)]" set:html={cuerpo} />
  </article>
</MarketingLayout>

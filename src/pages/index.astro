---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import Hero from "~/components/Hero.astro";
import PromoBanner from "~/components/PromoBanner.astro";
import ProductCard from "~/components/ProductCard.astro";
import ServiceCard from "~/components/ServiceCard.astro";
import StoreCard from "~/components/StoreCard.astro";
import SectionLabel from "~/components/SectionLabel.astro";
import { getCollection } from "astro:content";
import { services } from "~/data/services";
import { stores } from "~/data/stores";
import { site } from "~/data/site";
import { tradicion } from "~/data/tradicion";

const productsAll = await getCollection("products");
const featured = productsAll
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const heroImage = (await import("../../public/images/productos/bolleria.jpeg")).default;

const localBizJsonLd = stores.map((s) => ({
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: s.name,
  address: {
    "@type": "PostalAddress",
    streetAddress: s.address,
    addressLocality: s.city,
    postalCode: s.postal,
    addressCountry: "ES",
  },
  telephone: s.phone,
  geo: { "@type": "GeoCoordinates", latitude: s.coords.lat, longitude: s.coords.lng },
  openingHours: s.hoursText,
}));
---
<MarketingLayout
  title={site.name}
  description="Obrador artesano en Alcobendas y Pozuelo desde 1986. Comida casera para hogares y empresas: tartas y empanadas hechas cada mañana en horno propio."
  jsonLd={localBizJsonLd}
>
  <Hero
    eyebrow="Desde 1986 · Obrador artesano · Madrid"
    title="Más de 40 años"
    italicTail="haciéndolo bien."
    body="Comida casera para hogares y empresas. Tartas y empanadas hechas cada mañana en obrador propio, con método tradicional e ingredientes de siempre."
    image={heroImage}
    imageAlt="Bollería de obrador recién horneada"
    primaryCta={{ href: "/catalogo", label: "Ver el catálogo" }}
    secondaryCta={{ href: "/hosteleria-y-empresas", label: "Hostelería y empresas" }}
  />

  <!-- Claim de campaña: abre manifiesto y web -->
  <section class="bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-8 md:grid-cols-[1.2fr_1fr] md:items-end">
      <p class="font-[family-name:var(--font-display)] italic text-3xl sm:text-4xl lg:text-5xl leading-[1.1]">
        «{site.claim}»
      </p>
      <div>
        <p class="text-[color:var(--color-avellana)]">
          Métodos tradicionales. Ingredientes de siempre. Comida casera hecha para la vida de hoy.
        </p>
        <a href="/tradicion-y-calidad" class="btn btn-claro mt-6">Cómo lo hacemos</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <SectionLabel number="01" label="Lo que se comparte" />
        <h2 class="text-3xl sm:text-4xl mt-2">Lo que se pone en el centro de la mesa.</h2>
      </div>
      <a href="/catalogo" class="text-sm font-semibold underline whitespace-nowrap">Ver todo el catálogo →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => (
        <ProductCard
          slug={p.id}
          name={p.data.name}
          category={p.data.category}
          image={p.data.image}
          imageAlt={p.data.imageAlt}
          shortDescription={p.data.shortDescription}
          priceCents={p.data.priceCents}
          unit={p.data.unit}
          variants={p.data.variants}
        />
      ))}
    </div>
  </section>

  <PromoBanner
    label="Temporada · diciembre"
    title="Roscón de Reyes — reservas abiertas"
    ctaHref="/catalogo/roscon-de-reyes"
    ctaLabel="Reservar"
  />

  <section class="bg-[color:var(--color-latte)] border-y border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24">
      <SectionLabel number="02" label="Tres canales, una misma cocina" />
      <h2 class="text-3xl sm:text-4xl mt-2">A quién servimos cada día.</h2>
      <p class="max-w-xl text-[color:var(--color-ink-muted)] mt-3">{site.usp}</p>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
      <a href="/hosteleria-y-empresas" class="btn btn-primario mt-8">Dar de alta mi empresa</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24">
    <SectionLabel number="03" label="Las pruebas" />
    <h2 class="text-3xl sm:text-4xl mt-2">{tradicion.promesa}</h2>
    <p class="max-w-xl text-[color:var(--color-ink-muted)] mt-3">{tradicion.promesaBody}</p>
    <ul class="mt-10 grid gap-x-10 gap-y-6 md:grid-cols-3">
      {tradicion.pruebas.map((prueba, i) => (
        <li class="border-t border-[color:var(--color-avellana)] pt-4">
          <p class="numeracion">Nº 0{i + 1} —</p>
          <p class="mt-2 text-[color:var(--color-ink-muted)]">{prueba}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-16 sm:pb-24">
    <SectionLabel number="04" label="Dónde estamos" />
    <h2 class="text-3xl sm:text-4xl mt-2">Dos obradores en Madrid.</h2>
    <div class="mt-8 grid gap-8">
      {stores.map((s) => <StoreCard store={s} />)}
    </div>
  </section>
</MarketingLayout>

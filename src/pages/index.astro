---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import Hero from "~/components/Hero.astro";
import ProductCard from "~/components/ProductCard.astro";
import SectionLabel from "~/components/SectionLabel.astro";
import type { Producto } from "~/lib/db/productos";
import { catalogoPublico } from "~/lib/lectura-publica";
import type { CategoryId } from "~/data/categories";
import { stores } from "~/data/stores";
import { site } from "~/data/site";

// Lee el catálogo de la base de datos: bajo demanda, con la caché ISR delante
// y el panel invalidándola al guardar.
export const prerender = false;

// Un fallo de Postgres deja la home sin destacados, no una página rota — y
// marca la respuesta como `no-store` para que esa home sin destacados no se
// quede cacheada (`~/lib/lectura-publica.ts`).
const productsAll: Producto[] = await catalogoPublico(Astro.response);
// `listarProductos` ya devuelve en el orden de la carta.
const featured = productsAll.filter((p) => p.destacado).slice(0, 6);

/** La foto solo se pinta si tiene URL y las dos medidas: si falta alguna,
    la tarjeta cae al placeholder «Foto pendiente» en vez de romperse. */
function imagenDe(p: Producto): { url: string; alt: string; ancho: number; alto: number } | null {
  if (!p.imageUrl || !p.imageWidth || !p.imageHeight) return null;
  return { url: p.imageUrl, alt: p.imageAlt ?? p.name, ancho: p.imageWidth, alto: p.imageHeight };
}

const heroImage = (await import("../../public/images/productos/bolleria.jpeg")).default;

const localBizJsonLd = stores.map((s) => ({
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: s.name,
  address: {
    "@type": "PostalAddress",
    streetAddress: s.address,
    addressLocality: s.city,
    postalCode: s.postal,
    addressCountry: "ES",
  },
  telephone: s.phone,
  geo: { "@type": "GeoCoordinates", latitude: s.coords.lat, longitude: s.coords.lng },
  openingHours: s.hoursText,
}));
---
<MarketingLayout
  title={site.name}
  description="Obrador artesano en Alcobendas y Pozuelo desde 1986. Comida casera para hogares y empresas: tartas y empanadas hechas cada mañana en horno propio."
  jsonLd={localBizJsonLd}
>
  <Hero
    eyebrow="Desde 1986 · Obrador artesano · Madrid"
    title="Más de 40 años"
    italicTail="haciéndolo bien."
    body="Comida casera para hogares y empresas. Tartas y empanadas hechas cada mañana en obrador propio, con método tradicional e ingredientes de siempre."
    image={heroImage}
    imageAlt="Bollería de obrador recién horneada"
    primaryCta={{ href: "/catalogo", label: "Ver el catálogo" }}
    secondaryCta={{ href: "/a-quien-servimos", label: "A quién servimos" }}
  />

  <!-- Claim de campaña: abre manifiesto y web -->
  <section class="bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20 grid gap-8 md:grid-cols-[1.2fr_1fr] md:items-end">
      <p class="font-[family-name:var(--font-display)] italic text-3xl sm:text-4xl lg:text-5xl leading-[1.1]">
        «{site.claim}»
      </p>
      <div>
        <p class="text-[color:var(--color-avellana)]">
          Métodos tradicionales. Ingredientes de siempre. Comida casera hecha para la vida de hoy.
        </p>
        <a href="/tradicion-y-calidad" class="btn btn-claro mt-6">Cómo lo hacemos</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <SectionLabel number="01" label="Lo que se comparte" />
        <h2 class="text-3xl sm:text-4xl mt-2">Lo que se pone en el centro de la mesa.</h2>
      </div>
      <a href="/catalogo" class="text-sm font-semibold underline whitespace-nowrap">Ver todo el catálogo →</a>
    </div>
    <!-- Carrusel con scroll nativo: se arrastra en el móvil y con trackpad sin
         JS; las flechas pasan de una en una. -->
    <div class="carrusel-marco">
    <button type="button" class="carrusel-flecha carrusel-flecha--prev" data-carrusel-prev aria-controls="carrusel-destacados" aria-label="Producto anterior">‹</button>
    <button type="button" class="carrusel-flecha carrusel-flecha--next" data-carrusel-next aria-controls="carrusel-destacados" aria-label="Producto siguiente">›</button>
    <div
      id="carrusel-destacados"
      class="carrusel flex gap-5 overflow-x-auto snap-x snap-mandatory"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Productos destacados"
      tabindex="0"
    >
      {featured.map((p) => (
        <div class="carrusel-item snap-start shrink-0">
        <ProductCard
          slug={p.slug}
          name={p.name}
          category={p.category as CategoryId}
          imagen={imagenDe(p)}
          shortDescription={p.shortDescription}
          priceCents={p.priceCents ?? undefined}
          consultar={p.consultar}
          agotado={p.agotado}
          unit={p.unit ?? undefined}
          variants={p.variantes.map((v) => ({ id: v.variantId, label: v.label, priceCents: v.priceCents }))}
        />
        </div>
      ))}
    </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .carrusel {
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 0 1px 2px 0;
  }
  .carrusel::-webkit-scrollbar {
    display: none;
  }
  .carrusel:focus-visible {
    outline: 2px solid var(--color-caramelo);
    outline-offset: 4px;
  }
  /* Móvil: una tarjeta y un asomo de la siguiente, para que se vea que hay más. */
  .carrusel-item {
    flex-basis: 82%;
  }
  @media (min-width: 640px) {
    .carrusel-item {
      flex-basis: calc((100% - 1.25rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .carrusel-item {
      flex-basis: calc((100% - 2.5rem) / 3);
    }
  }
  /* Las flechas van sobre la foto, a media altura de ella. La foto es 4:3,
     así que su centro queda a 3/8 del ancho de la tarjeta; con `cqw` ese
     ancho se calcula igual que el `flex-basis` de cada tramo. */
  .carrusel-marco {
    position: relative;
    container-type: inline-size;
    --tarjeta: 82cqw;
  }
  @media (min-width: 640px) {
    .carrusel-marco {
      --tarjeta: calc((100cqw - 1.25rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .carrusel-marco {
      --tarjeta: calc((100cqw - 2.5rem) / 3);
    }
  }
  .carrusel-flecha {
    position: absolute;
    z-index: 2;
    top: calc(var(--tarjeta) * 0.375);
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-avellana);
    background: var(--color-leche);
    color: var(--color-moka);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .carrusel-flecha--prev {
    left: 8px;
  }
  .carrusel-flecha--next {
    right: 8px;
  }
  .carrusel-flecha:hover {
    background: var(--color-latte);
  }
  .carrusel-flecha:disabled {
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .carrusel {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const pista = document.getElementById("carrusel-destacados");
  const prev = document.querySelector<HTMLButtonElement>("[data-carrusel-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-carrusel-next]");

  if (pista && prev && next) {
    const actualiza = () => {
      const max = pista.scrollWidth - pista.clientWidth;
      prev.disabled = pista.scrollLeft <= 1;
      // Con todo en pantalla quedan las dos desactivadas, o sea, ocultas.
      next.disabled = pista.scrollLeft >= max - 1;
    };
    // Un paso = una tarjeta más el hueco entre tarjetas.
    const paso = () => {
      const a = pista.children[0] as HTMLElement | undefined;
      const b = pista.children[1] as HTMLElement | undefined;
      return a && b ? b.offsetLeft - a.offsetLeft : pista.clientWidth;
    };
    prev.addEventListener("click", () => pista.scrollBy({ left: -paso() }));
    next.addEventListener("click", () => pista.scrollBy({ left: paso() }));
    pista.addEventListener("scroll", actualiza, { passive: true });
    window.addEventListener("resize", actualiza);
    actualiza();
  }
</script>

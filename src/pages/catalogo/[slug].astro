---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import AddToCart from "~/islands/AddToCart.tsx";
import { categoryById } from "~/data/categories";
import { seccionById } from "~/data/secciones";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const cat = categoryById(product.data.category);
const seccion = product.data.seccion ? seccionById(product.data.seccion) : null;
const eyebrow = seccion?.label ?? cat.label;

const allergensLabel: Record<string, string> = {
  gluten: "gluten",
  huevo: "huevo",
  leche: "leche",
  "frutos-secos": "frutos secos",
  soja: "soja",
  sesamo: "sésamo",
  sulfitos: "sulfitos",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.data.name,
  description: product.data.shortDescription,
  ...(product.data.image
    ? { image: new URL(product.data.image.src, Astro.site).toString() }
    : {}),
  category: cat.label,
  ...(product.data.priceCents !== undefined && !product.data.consultar
    ? {
        offers: {
          "@type": "Offer",
          priceCurrency: "EUR",
          price: (product.data.priceCents / 100).toFixed(2),
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Catálogo", item: new URL("/catalogo", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: product.data.name },
  ],
};
---
<MarketingLayout
  title={product.data.name}
  description={product.data.shortDescription}
  type="product"
  jsonLd={[jsonLd, breadcrumbs]}
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
    <nav aria-label="Breadcrumb" class="text-xs text-[color:var(--color-ink-muted)] uppercase tracking-widest mb-6">
      <a href="/">Inicio</a> · <a href="/catalogo">Catálogo</a> · <span>{product.data.name}</span>
    </nav>

    <div class="grid gap-10 md:grid-cols-2">
      <div class="self-start rounded-[var(--radius-card)] overflow-hidden border border-[color:var(--color-line)]">
        {product.data.image ? (
          <Image
            src={product.data.image}
            alt={product.data.imageAlt ?? product.data.name}
            widths={[600, 900, 1200]}
            sizes="(min-width:768px) 600px, 100vw"
            class="w-full h-auto"
          />
        ) : (
          <div
            class="aspect-[4/3] flex items-center justify-center bg-[color:var(--color-latte)]"
            aria-hidden="true"
          >
            <span class="numeracion">Foto pendiente</span>
          </div>
        )}
      </div>

      <div>
        <p class="numeracion">{eyebrow}</p>
        <h1 class="text-4xl sm:text-5xl mt-2">{product.data.name}</h1>
        {seccion?.nota && (
          <p class="mt-2 text-xs text-[color:var(--color-ink-muted)]">{seccion.nota}</p>
        )}
        <p class="text-lg text-[color:var(--color-ink-muted)] mt-3">{product.data.shortDescription}</p>

        <div class="mt-6 max-w-md">
          {product.data.consultar || product.data.priceCents === undefined ? (
            <div>
              <p class="font-[family-name:var(--font-display)] text-3xl text-[color:var(--color-ink-muted)]">
                Precio a consultar
              </p>
              <p class="mt-2 text-sm text-[color:var(--color-ink-muted)]">
                La carta no fija precio para esta referencia: se ajusta con el
                obrador según el encargo.
              </p>
              <a href="/contacto" class="btn btn-primario mt-4">Preguntar por este producto</a>
            </div>
          ) : (
            <AddToCart
              client:load
              slug={product.id}
              name={product.data.name}
              unitPriceCents={product.data.priceCents}
              unit={product.data.unit}
              variants={product.data.variants}
            />
          )}
        </div>

        {product.data.allergens.length > 0 && (
          <div class="mt-8">
            <p class="numeracion">Alérgenos</p>
            <p class="mt-1 text-sm">Contiene: {product.data.allergens.map((a) => allergensLabel[a]).join(", ")}.</p>
          </div>
        )}

        <article class="mt-8 prose prose-stone max-w-none [&_p]:my-3 text-[color:var(--color-ink)]">
          <Content />
        </article>
      </div>
    </div>
  </section>
</MarketingLayout>

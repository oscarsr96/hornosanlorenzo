---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import CatalogoGrid from "~/components/CatalogoGrid.astro";

// Lee el catálogo de la base de datos: bajo demanda, con la caché ISR delante
// y el panel invalidándola al guardar.
export const prerender = false;
---
<MarketingLayout
  title="Salado"
  description="Empanadas, supremas de hojaldre, quiches y tartas saladas de obrador propio."
>
  <CatalogoGrid
    grupo="salado"
    eyebrow="Nuestros productos · Salado"
    title="El secreto de comer bien lleva 40 años en nuestra casa."
    intro="Empanadas y supremas de hojaldre, quiches y tartas saladas. Masa laminada con mantequilla y rellenos de la casa."
    porSeccion
  />
</MarketingLayout>

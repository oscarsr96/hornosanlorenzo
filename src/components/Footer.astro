---
import { site } from "~/data/site";
import { stores } from "~/data/stores";
import SocialLinks from "~/components/SocialLinks.astro";
import Sello from "~/components/Sello.astro";
const year = new Date().getFullYear();
---
<footer class="bg-[color:var(--color-cream)] border-t border-[color:var(--color-line)] mt-24" transition:persist>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 grid gap-8 md:grid-cols-4 text-sm">
    <div>
      <Sello class="w-20 h-20" />
      <p class="mt-4 font-[family-name:var(--font-display)] italic text-lg text-[color:var(--color-ink)]">{site.name}</p>
      <p class="mt-2 text-[color:var(--color-ink-muted)] max-w-xs">{site.tagline}</p>
      <p class="mt-4 text-xs text-[color:var(--color-ink-muted)]">{site.noteForDemo}</p>
    </div>
    <div>
      <p class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-ink-muted)] font-semibold">Tiendas</p>
      <ul class="mt-3 space-y-3">
        {stores.map((s) => (
          <li>
            <p class="font-semibold text-[color:var(--color-ink)]">{s.shortName}</p>
            <p class="text-[color:var(--color-ink-muted)]">{s.address}</p>
            <p class="text-[color:var(--color-ink-muted)]">{s.phoneDisplay}</p>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-ink-muted)] font-semibold">Navegación</p>
      <ul class="mt-3 space-y-2">
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/servicios">Servicios</a></li>
        <li><a href="/tradicion-y-calidad">Tradición y calidad</a></li>
        <li><a href="/noticias">Noticias</a></li>
        <li><a href="/contacto">Contacto</a></li>
      </ul>
    </div>
    <div>
      <p class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-ink-muted)] font-semibold">Legal</p>
      <ul class="mt-3 space-y-2">
        <li><a href="/legal/aviso-legal">Aviso legal</a></li>
        <li><a href="/legal/privacidad">Privacidad</a></li>
        <li><a href="/legal/cookies">Cookies</a></li>
      </ul>
      <p class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-ink-muted)] font-semibold mt-6">Síguenos</p>
      <SocialLinks class="mt-3" />
    </div>
  </div>
  <div class="border-t border-[color:var(--color-line)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4 text-xs text-[color:var(--color-ink-muted)] flex flex-col sm:flex-row justify-between gap-2">
      <span>© {year} {site.name}. Todos los derechos reservados.</span>
      <span>Hecho con cariño en Madrid.</span>
    </div>
  </div>
</footer>

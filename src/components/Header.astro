---
import CartBadge from "~/islands/CartBadge.tsx";
import { site } from "~/data/site";

const links = [
  { href: "/catalogo",            label: "Catálogo" },
  { href: "/servicios",           label: "Servicios" },
  { href: "/noticias",            label: "Noticias" },
  { href: "/tradicion-y-calidad", label: "Tradición" },
  { href: "/tiendas",             label: "Tiendas" },
  { href: "/contacto",            label: "Contacto" },
];

const here = Astro.url.pathname;
---
<header
  class="border-b border-[color:var(--color-line)] sticky top-0 z-50 backdrop-blur"
  transition:persist
>
  <!-- Top band: logo -->
  <div class="bg-[color:var(--color-cream)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4 sm:py-5 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
      <span aria-hidden="true"></span>

      <a
        href="/"
        class="flex flex-col items-center leading-none"
        aria-label={`${site.name} — inicio`}
      >
        <img
          src="/logo.png"
          alt="Horno San Lorenzo"
          width="1336"
          height="552"
          class="h-12 sm:h-16 w-auto"
          decoding="async"
          fetchpriority="high"
        />
        <span class="mt-1 text-[10px] uppercase tracking-[0.25em] text-[color:var(--color-ink-muted)] font-semibold">
          desde 1986
        </span>
      </a>

      <div class="flex items-center justify-end gap-3">
        <CartBadge client:only="react" />
        <button
          class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-full border border-[color:var(--color-line)] text-[color:var(--color-ink)]"
          aria-label="Abrir menú"
          onclick="document.getElementById('mobile-nav').classList.toggle('hidden')"
          type="button"
        >
          ☰
        </button>
      </div>
    </div>
  </div>

  <!-- Bottom band: red nav -->
  <nav
    aria-label="Principal"
    class="hidden md:block bg-[color:var(--color-hot)] text-white"
  >
    <ul class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-center gap-8 text-sm font-semibold uppercase tracking-[0.12em]">
      {links.map((l) => {
        const active = l.href === "/" ? here === "/" : here.startsWith(l.href);
        return (
          <li>
            <a
              href={l.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "block py-3 text-white/90 hover:text-white border-b-2 border-transparent hover:border-white/60 transition-colors",
                active && "text-white border-white",
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Mobile menu (collapsed) -->
  <nav
    id="mobile-nav"
    aria-label="Móvil"
    class="md:hidden hidden bg-[color:var(--color-hot)] text-white"
  >
    <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-2 text-sm font-semibold uppercase tracking-[0.12em]">
      {links.map((l) => (
        <a href={l.href} data-mobile-nav-link class="py-2 text-white/95">{l.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const closeMobileNav = () => {
    document.getElementById("mobile-nav")?.classList.add("hidden");
  };

  // Close immediately on tap (before navigation finishes)
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest("[data-mobile-nav-link]")) closeMobileNav();
  });

  // Also close after every view-transition page swap (covers back/forward)
  document.addEventListener("astro:page-load", closeMobileNav);
</script>

---
import CartBadge from "~/islands/CartBadge.tsx";
import SocialLinks from "~/components/SocialLinks.astro";
import Firma from "~/components/Firma.astro";
import { site } from "~/data/site";

const links = [
  { href: "/catalogo",            label: "Catálogo" },
  { href: "/servicios",           label: "Servicios" },
  { href: "/noticias",            label: "Noticias" },
  { href: "/tradicion-y-calidad", label: "Tradición" },
  { href: "/tiendas",             label: "Tiendas" },
  { href: "/contacto",            label: "Contacto" },
];

const here = Astro.url.pathname;
---
<header
  class="sticky top-0 z-50 bg-[color:var(--color-leche)]/95 backdrop-blur border-b border-[color:var(--color-avellana)]"
  transition:persist
>
  <!-- La cinta cromática: la paleta en proporción, una por pieza -->
  <div class="cinta" aria-hidden="true">
    <span style="flex:70;background:var(--color-leche)"></span>
    <span style="flex:14;background:var(--color-latte)"></span>
    <span style="flex:8;background:var(--color-avellana)"></span>
    <span style="flex:4;background:var(--color-caramelo)"></span>
    <span style="flex:3;background:var(--color-moka)"></span>
    <span style="flex:1;background:var(--color-teja)"></span>
  </div>

  <!-- Banda superior: La Firma -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4 sm:py-6 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
    <SocialLinks class="hidden md:flex" />

    <a href="/" aria-label={`${site.name} — inicio`} class="justify-self-center">
      <Firma />
    </a>

    <div class="flex items-center justify-end gap-2">
      <CartBadge client:only="react" />
      <button
        class="md:hidden inline-flex items-center justify-center w-12 h-12 border border-[color:var(--color-avellana)] text-[color:var(--color-moka)]"
        aria-label="Abrir menú"
        onclick="document.getElementById('mobile-nav').classList.toggle('hidden')"
        type="button"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- Banda de navegación -->
  <nav
    aria-label="Principal"
    class="hidden md:block bg-[color:var(--color-latte)] border-t border-[color:var(--color-avellana)]"
  >
    <ul class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-center gap-9 text-[11px] font-medium uppercase tracking-[0.18em]">
      {links.map((l) => {
        const active = l.href === "/" ? here === "/" : here.startsWith(l.href);
        return (
          <li>
            <a
              href={l.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "block py-4 border-b-2 border-transparent transition-colors",
                active
                  ? "text-[color:var(--color-caramelo)] border-[color:var(--color-caramelo)]"
                  : "text-[color:var(--color-moka)] hover:text-[color:var(--color-caramelo)]",
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Menú móvil (plegado) -->
  <nav
    id="mobile-nav"
    aria-label="Móvil"
    class="md:hidden hidden bg-[color:var(--color-latte)] border-t border-[color:var(--color-avellana)]"
  >
    <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col text-[11px] font-medium uppercase tracking-[0.18em]">
      {links.map((l) => (
        <a
          href={l.href}
          data-mobile-nav-link
          class="py-3 text-[color:var(--color-moka)] border-b border-[color:var(--color-avellana)]/60"
        >{l.label}</a>
      ))}
      <SocialLinks class="mt-4" />
    </div>
  </nav>
</header>

<script>
  const closeMobileNav = () => {
    document.getElementById("mobile-nav")?.classList.add("hidden");
  };

  // Close immediately on tap (before navigation finishes)
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest("[data-mobile-nav-link]")) closeMobileNav();
  });

  // Also close after every view-transition page swap (covers back/forward)
  document.addEventListener("astro:page-load", closeMobileNav);
</script>

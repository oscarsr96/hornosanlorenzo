---
import ProductCard from "~/components/ProductCard.astro";
import CategoryFilter from "~/islands/CategoryFilter.tsx";
import { listarProductos, type Producto } from "~/lib/db/productos";
import { grupoCategories, grupoOfCategory, grupoLabel, type GrupoId, type CategoryId } from "~/data/categories";
import { secciones, seccionById, type SeccionId } from "~/data/secciones";
import { stores } from "~/data/stores";

interface Props {
  grupo?: GrupoId | null;
  eyebrow: string;
  title: string;
  intro: string;
  /** Agrupa el listado en los bloques de la carta impresa. */
  porSeccion?: boolean;
  /** Solo los marcados como destacados, sin filtrar por grupo. */
  destacados?: boolean;
  conFiltro?: boolean;
  /** Filtra por gama comercial (Dulce / Salado) en vez de por categoría. */
  porGrupo?: boolean;
}
const {
  grupo = null,
  eyebrow,
  title,
  intro,
  porSeccion = false,
  destacados = false,
  conFiltro = true,
  porGrupo = false,
} = Astro.props;

const allowed = grupo ? grupoCategories[grupo] : null;

// Solo los activos: una ficha desactivada desde el panel desaparece de la
// web. `listarProductos` ya los devuelve en el orden de la carta.
let todos: Producto[] = [];
try {
  todos = await listarProductos({ soloActivos: true });
} catch (error) {
  // Un fallo de Postgres deja el catálogo vacío, no una página rota.
  console.error(
    "No se pudo cargar el catálogo:",
    error instanceof Error ? error.message : error,
  );
}

const products = todos
  .filter((p) => (destacados ? p.destacado : true))
  .filter((p) => !allowed || allowed.includes(p.category as CategoryId));

/** Solo las secciones que tienen producto, en el orden de la carta. */
const bloques = porSeccion
  ? secciones
      .map((s) => ({
        seccion: s,
        items: products.filter((p) => p.seccion === s.id),
      }))
      .filter((b) => b.items.length > 0)
  : [];

/** Productos sin sección: en modo carta se listan al final. */
const sueltos = porSeccion ? products.filter((p) => !p.seccion) : products;

/** Gamas presentes en el listado, para los chips del filtro. */
const gamas = porGrupo
  ? ([...new Set(products.map((p) => grupoOfCategory(p.category as CategoryId)))]
      .filter((g): g is GrupoId => g !== null)
      .map((g) => ({ id: g, label: grupoLabel[g] })))
  : undefined;

/** La foto solo se pinta si tiene URL y las dos medidas: si falta alguna,
    la tarjeta cae al placeholder «Foto pendiente» en vez de romperse. */
function imagenDe(p: Producto): { url: string; alt: string; ancho: number; alto: number } | null {
  if (!p.imageUrl || !p.imageWidth || !p.imageHeight) return null;
  return { url: p.imageUrl, alt: p.imageAlt ?? p.name, ancho: p.imageWidth, alto: p.imageHeight };
}
---
<section class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
  <p class="numeracion">{eyebrow}</p>
  <h1 class="text-4xl sm:text-5xl mt-2">{title}</h1>
  <p class="text-[color:var(--color-ink-muted)] mt-3 max-w-xl">{intro}</p>

  {conFiltro && (
    <div class="mt-8">
      <CategoryFilter
        client:load
        grupo={grupo}
        secciones={porSeccion ? bloques.map((b) => ({ id: b.seccion.id, label: b.seccion.label })) : undefined}
        grupos={gamas}
      />
    </div>
  )}

  {porSeccion ? (
    <div class="mt-10 flex flex-col gap-14">
      {bloques.map((b) => (
        <div data-seccion={b.seccion.id}>
          <div class="filete pb-3">
            <p class="numeracion">{b.seccion.eyebrow}</p>
            <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl mt-1">
              {b.seccion.label}
            </h2>
            {b.seccion.nota && (
              <p class="mt-2 text-sm text-[color:var(--color-ink-muted)]">{b.seccion.nota}</p>
            )}
            {b.seccion.aviso && (
              <p class="mt-3 text-sm border-l-2 border-[color:var(--color-caramelo)] pl-3">
                {b.seccion.aviso}{" "}
                {stores.map((s, i) => (
                  <>
                    {i > 0 && " · "}
                    <a href={`tel:${s.phone}`} class="underline font-semibold whitespace-nowrap">
                      {s.shortName} {s.phoneDisplay}
                    </a>
                  </>
                ))}
              </p>
            )}
          </div>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {b.items.map((p) => (
              <div
                data-product
                data-category={p.category}
                data-grupo={grupoOfCategory(p.category as CategoryId)}
                data-seccion={p.seccion}
                data-search={`${p.name} ${p.shortDescription} ${b.seccion.label}`}
              >
                <ProductCard
                  slug={p.slug}
                  name={p.name}
                  category={p.category as CategoryId}
                  seccionLabel={seccionById(b.seccion.id).label}
                  imagen={imagenDe(p)}
                  shortDescription={p.shortDescription}
                  priceCents={p.priceCents ?? undefined}
                  consultar={p.consultar}
                  agotado={p.agotado}
                  unit={p.unit ?? undefined}
                  variants={p.variantes.map((v) => ({ id: v.variantId, label: v.label, priceCents: v.priceCents }))}
                />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {sueltos.map((p) => (
        <div
          data-product
          data-category={p.category}
          data-grupo={grupoOfCategory(p.category as CategoryId)}
          data-seccion={p.seccion}
          data-search={`${p.name} ${p.shortDescription} ${p.seccion ? seccionById(p.seccion as SeccionId).label : ""}`}
        >
          <ProductCard
            slug={p.slug}
            name={p.name}
            category={p.category as CategoryId}
            seccionLabel={p.seccion ? seccionById(p.seccion as SeccionId).label : undefined}
            imagen={imagenDe(p)}
            shortDescription={p.shortDescription}
            priceCents={p.priceCents ?? undefined}
            consultar={p.consultar}
            agotado={p.agotado}
            unit={p.unit ?? undefined}
            variants={p.variantes.map((v) => ({ id: v.variantId, label: v.label, priceCents: v.priceCents }))}
          />
        </div>
      ))}
    </div>
  )}
</section>

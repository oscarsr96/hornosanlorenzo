---
import { Image } from "astro:assets";
import AddToCart from "~/islands/AddToCart.tsx";
import { categoryById, isCategoryId, type CategoryId } from "~/data/categories";
import { formatPriceCents } from "~/lib/format";

interface Props {
  slug: string;
  name: string;
  category: CategoryId;
  /** Etiqueta de la sección de la carta; manda sobre la categoría. */
  seccionLabel?: string;
  /** Foto del almacén con sus medidas, o nada si la ficha aún no tiene. */
  imagen?: { url: string; alt: string; ancho: number; alto: number } | null;
  shortDescription: string;
  priceCents?: number;
  /** La carta no da precio: se consulta con el obrador. */
  consultar?: boolean;
  /** Se ve en la carta, pero hoy no se puede comprar. */
  agotado?: boolean;
  unit?: string;
  variants?: { id: string; label: string; priceCents: number }[];
}

const {
  slug,
  name,
  category,
  seccionLabel,
  imagen = null,
  shortDescription,
  priceCents,
  consultar = false,
  agotado = false,
  unit,
  variants,
} = Astro.props;

// `category` llega ya convertida con `as CategoryId` desde quien la pinta,
// pero la columna de la base de datos es texto libre sin CHECK ni FK: el
// compilador no puede garantizar que ese valor exista de verdad en
// `categories.ts`. `isCategoryId` es la comprobación en tiempo de
// ejecución; sin ella, un valor inválido tira `categoryById` (que sí
// asume que existe) y con él toda la tarjeta.
const eyebrow = seccionLabel ?? (isCategoryId(category) ? categoryById(category).label : undefined) ?? "";
/** Con varios tamaños la tarjeta lleva selector y el precio lo pone la isla. */
const conTamanos = Boolean(variants && variants.length > 1);
/**
 * El precio que se pinta tiene que ser el que se va a cobrar.
 *
 * Con UN solo tamaño la tarjeta no lleva selector, pero `AddToCart` arranca
 * con `variants[0]` ya seleccionada y mete en el carrito SU precio, no el
 * `priceCents` base. Mientras la carta vivía en los 98 Markdown los dos
 * números coincidían siempre (el base era el del tamaño más barato); desde
 * que el panel los edita por separado pueden no coincidir, y entonces el
 * cliente veía un importe en la tarjeta y pagaba otro sin haber tocado nada
 * ni hecho falta petición amañada ninguna. Con dos o más tamaños esto no
 * hace falta: ahí el precio lo pinta la isla, que ya usa el de la variante.
 */
const precioTarjeta =
  variants && variants.length === 1 ? variants[0].priceCents : priceCents;
const sinPrecio = consultar || priceCents === undefined;
---
<article class="group bg-[color:var(--color-paper)] border border-[color:var(--color-line)] rounded-[var(--radius-card)] overflow-hidden shadow-[var(--shadow-card)] hover:scale-[1.02] transition-transform duration-200">
  <a href={`/catalogo/${slug}`} class="block">
    <div class="aspect-[4/3] overflow-hidden">
      {imagen ? (
        <Image quality={80}
          src={imagen.url}
          alt={imagen.alt}
          width={imagen.ancho}
          height={imagen.alto}
          widths={[300, 600, 900]}
          sizes="(min-width:1024px) 360px, (min-width:640px) 50vw, 100vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div
          class="w-full h-full flex items-center justify-center bg-[color:var(--color-latte)] border-b border-[color:var(--color-avellana)]"
          aria-hidden="true"
        >
          <span class="numeracion">Foto pendiente</span>
        </div>
      )}
    </div>
  </a>
  <div class="p-4 sm:p-5">
    <p class="numeracion">{eyebrow}</p>
    <h3 class="font-[family-name:var(--font-display)] text-xl mt-1">
      <a href={`/catalogo/${slug}`} class="hover:text-[color:var(--color-accent-dark)]">{name}</a>
    </h3>
    <p class="text-sm text-[color:var(--color-ink-muted)] mt-1 line-clamp-2">{shortDescription}</p>
    <div class="mt-4">
      {agotado ? (
        /* Visible pero no comprable: se ve el precio (o «Consultar»), sin
           botón de añadir.

           OJO: aquí `agotado` va ANTES que `consultar`, al revés que en
           `~/lib/pedido.ts` y en `catalogo/[slug].astro`, y NO es la misma
           decisión ni la contradice. Allí hay que escoger UN mensaje entre
           dos excluyentes, y la regla del proyecto es que gana «consultar»:
           un producto sin precio de venta online no es de los que vuelven a
           salir del horno, así que prometer una reposición sería engañoso.
           Aquí no se escoge: esta rama enseña «Consultar» como precio Y la
           etiqueta «Agotado hoy», es decir, las dos cosas a la vez. Ponerla
           después de la de «consultar» no arreglaría ninguna incoherencia,
           solo perdería la etiqueta de agotado. */
        <div class="flex items-center justify-between">
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold text-[color:var(--color-ink-muted)]">
            {sinPrecio ? "Consultar" : formatPriceCents(precioTarjeta!)}
          </p>
          <span class="numeracion">Agotado hoy</span>
        </div>
      ) : sinPrecio ? (
        <div class="flex items-center justify-between">
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold text-[color:var(--color-ink-muted)]">
            Consultar
          </p>
          <a
            href="/contacto"
            class="inline-flex items-center h-9 px-4 border border-[color:var(--color-avellana)] text-[13px] font-semibold text-[color:var(--color-moka)] hover:border-[color:var(--color-moka)] transition-colors"
          >
            Preguntar
          </a>
        </div>
      ) : conTamanos ? (
        /* El precio lo pinta la isla: cambia con el tamaño elegido. */
        <AddToCart
          client:visible
          slug={slug}
          name={name}
          unitPriceCents={precioTarjeta!}
          variants={variants}
          compact={true}
        />
      ) : (
        <div class="flex items-center justify-between">
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold">
            {formatPriceCents(precioTarjeta!)}{unit && <span class="text-xs text-[color:var(--color-ink-muted)] font-normal"> / {unit}</span>}
          </p>
          <AddToCart
            client:visible
            slug={slug}
            name={name}
            unitPriceCents={precioTarjeta!}
            variants={variants}
            compact={true}
          />
        </div>
      )}
    </div>
  </div>
</article>
